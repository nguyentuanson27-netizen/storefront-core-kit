generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncEventStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum LocalOrderState {
  DRAFT
  VALIDATING
  POS_SUBMITTING
  CONFIRMED
  REJECTED
  SYNC_UNKNOWN
}

enum ProductContentStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

/// ADR 0007 — Merchant apparel facts.
///
/// These are the reviewed Google Merchant controlled values, held as database enums so an
/// out-of-allowlist value cannot be persisted at all. The application layer still validates every
/// admin submission and every value it reads back: the database constraint is defence in depth, not
/// the only gate.
enum MerchantGender {
  MALE
  FEMALE
  UNISEX
}

enum MerchantAgeGroup {
  NEWBORN
  INFANT
  TODDLER
  KIDS
  ADULT
}

enum MerchantCondition {
  NEW
  REFURBISHED
  USED
}

enum SellingMode {
  STANDARD
  OVERSELL
  PREORDER
}

enum PromotionCampaignKind {
  PROMOTION
  FLASH_SALE
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_PRICE
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  role          UserRole      @default(CUSTOMER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  carts         Cart[]
  orders        OrderMirror[]
  sellingPoliciesUpdated ProductSellingPolicy[] @relation("SellingPolicyUpdatedBy")
  newArrivalsUpdated NewArrivalsSelection[] @relation("NewArrivalsUpdatedBy")
  homepageFeaturedUpdated HomepageFeaturedProduct[] @relation("HomepageFeaturedUpdatedBy")
  relatedOverridesUpdated RelatedProductOverride[] @relation("RelatedOverrideUpdatedBy")
  sizeGuideMediaUpdated SizeGuideMedia[] @relation("SizeGuideMediaUpdatedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                   String?
  password                String?
  createdAt               DateTime
  updatedAt               DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt DateTime?
  updatedAt DateTime?

  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  provinceRef   String
  districtRef   String
  communeRef    String
  detail        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductMirror {
  id                String               @id @default(cuid())
  pancakeShopId     Int                  @default(0)
  pancakeProductId  String               @unique
  slug              String               @unique
  name              String
  sourceDescription String?
  primaryImageUrl   String?
  isPresent         Boolean              @default(true)
  isActive          Boolean              @default(true)
  syncedAt          DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  variants          VariantMirror[]
  content           ProductContent?
  merchantFacts     ProductMerchantFacts?
  sellingPolicy     ProductSellingPolicy?
  newArrivalsSelection NewArrivalsSelection?
  homepageFeatured HomepageFeaturedProduct?
  relatedOverrides RelatedProductOverride[] @relation("RelatedOverrideOwner")
  relatedOverrideRefs RelatedProductOverride[] @relation("RelatedOverrideTarget")
  slugHistory       ProductSlugHistory[]
  promotionTargets  PromotionTarget[]

  @@index([pancakeShopId, isPresent])
}

model ProductSlugHistory {
  slug      String        @id
  productId String
  createdAt DateTime      @default(now())
  product   ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductContent {
  id                   String               @id @default(cuid())
  productId            String               @unique
  status               ProductContentStatus @default(DRAFT)
  editorialDescription String?
  /** Fabric composition as one editorial sentence, e.g. "100% cotton dệt kim". */
  material             String?
  /** Construction notes, one per entry, rendered as a list rather than a paragraph. */
  craftDetails         String[]             @default([])
  careInstructions     String?
  sizeGuide             String?
  seoTitle              String?
  seoDescription        String?
  collectionSlugs      String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  product               ProductMirror        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// ADR 0007 — website-owned Merchant apparel overrides for one product.
///
/// Absence is inheritance, never "unknown": a null column means this product uses the approved shop
/// default for that fact, and clearing an override in admin removes the value rather than copying
/// the current default into the row. The three facts are independent, so a product may override one
/// and inherit the other two.
///
/// This table is website-owned. Pancake catalog sync never writes, clears or derives it — that is
/// what keeps a resync from silently erasing a merchandising decision. It is deliberately separate
/// from `ProductContent` so that an editorial publication state cannot gate a Merchant fact, and
/// separate from the Pancake mirror columns so that ownership is visible in the schema itself.
model ProductMerchantFacts {
  id        String             @id @default(cuid())
  productId String             @unique
  gender    MerchantGender?
  ageGroup  MerchantAgeGroup?
  condition MerchantCondition?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   ProductMirror      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Website-owned selling policy (spec: docs/specs/core-kit-selling-modes-v1.md §4). Catalog sync never
/// reads or writes it. A product with no row is `STANDARD` with the default limit; that answer belongs
/// to `resolveSellingPolicy()`, not to a column default, because no row means no default was applied.
/// `negativeStockLimit` is range-checked by a hand-written CHECK in the migration.
model ProductSellingPolicy {
  productId          String        @id
  sellingMode        SellingMode
  negativeStockLimit Int
  updatedAt          DateTime      @updatedAt
  updatedByUserId    String?
  product            ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy          User?         @relation("SellingPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model CollectionDefinition {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String?
  seoTitle           String?
  seoDescription     String?
  /** Editorial media. `description` is the collection's story; there is no separate story field. */
  heroImageUrl       String?
  /** Optional art-directed hero for narrow viewports; the desktop hero is the fallback. */
  heroMobileImageUrl String?
  galleryImageUrls   String[] @default([])
  videoSrcUrl        String?
  videoPosterUrl     String?
  /** Slugs the merchandiser pinned to the top of the grid, in the order they should appear. */
  featuredProductSlugs String[] @default([])
  isPublished        Boolean  @default(false)
  homepagePosition   Int?     @unique
  pancakeCategoryIds Int[]    @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One shared rule across all of a campaign's targets.
///
/// Admin-visible status (Draft / Scheduled / Active / Ended / Disabled) is derived, never stored:
/// `isEnabled`, `enabledAt`, `disabledAt` and the configured window are enough to decide whether an
/// enabled interval ever overlapped an active one. Persisting a status — or an "ever active" flag
/// written when a request happens to observe the campaign — would be wrong after a restart or for a
/// window that opened and closed with zero traffic.
///
/// Website-owned money is integer VND: an integer percentage, or a `BigInt` final unit price. The
/// mirrored Pancake `Float?` columns stay external facts and are not converted here.
model PromotionCampaign {
  id              String                @id @default(cuid())
  kind            PromotionCampaignKind
  name            String
  discountType    PromotionDiscountType
  percentageValue Int?
  fixedPriceVnd   BigInt?
  startsAt        DateTime?
  endsAt          DateTime?
  isEnabled       Boolean               @default(false)
  enabledAt       DateTime?
  disabledAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  targets         PromotionTarget[]

  @@index([isEnabled, startsAt, endsAt])
}

/// Exactly one of `productId` / `variantId` is populated, enforced by a database check rather than
/// by the admin UI. A PRODUCT row is a semantic scope over the product's current variants — it is
/// deliberately not materialized into a frozen variant list, so variants synced or restored later
/// are covered without a rewrite.
model PromotionTarget {
  id         String            @id @default(cuid())
  campaignId String
  productId  String?
  variantId  String?
  createdAt  DateTime          @default(now())
  campaign   PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    ProductMirror?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    VariantMirror?    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@unique([campaignId, variantId])
  @@index([productId])
  @@index([variantId])
}

/// One durable, server-owned, monotonic revision of effective promotion pricing.
///
/// A single row by construction: bounded cardinality is the point, so a Merchant cache decision can
/// read the current generation cheaply and a promotion mutation can advance it inside the same
/// transaction that commits the mutation. Nothing request-controlled reaches it, and it never grows
/// per campaign or per request.
model PromotionPricingRevision {
  id        String   @id @default("current")
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model VariantMirror {
  id                              String                     @id @default(cuid())
  pancakeVariationId              String                     @unique
  productId                       String
  pancakeDisplayId                String?
  pancakeBarcode                  String?
  pancakeFields                   Json?
  pancakeImageUrls                Json?
  pancakeIsHidden                 Boolean?
  pancakeIsLocked                 Boolean?
  pancakeRetailPrice              Float?
  pancakeRetailPriceAfterDiscount Float?
  sku                             String?
  color                           String?
  size                            String?
  isPresent                       Boolean                    @default(true)
  isActive                        Boolean                    @default(true)
  syncedAt                        DateTime
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  product                         ProductMirror              @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseStocks                 WarehouseStock[]
  cartItems                       CartItem[]
  compositeComponents             CompositeComponentMirror[] @relation("CompositeParent")
  compositeParents                CompositeComponentMirror[] @relation("CompositeComponent")
  promotionTargets                PromotionTarget[]
  capacityReservations            CapacityReservation[]
  capacityResources               CapacityReservationResource[]

  @@index([productId])
  @@index([sku])
  @@index([isPresent])
}

model CompositeComponentMirror {
  parentVariantId    String
  componentVariantId String
  quantity           Int
  syncedAt           DateTime
  parentVariant      VariantMirror @relation("CompositeParent", fields: [parentVariantId], references: [id], onDelete: Cascade)
  componentVariant   VariantMirror @relation("CompositeComponent", fields: [componentVariantId], references: [id], onDelete: Cascade)

  @@id([parentVariantId, componentVariantId])
  @@index([componentVariantId])
}

model WarehouseStock {
  id                 String        @id @default(cuid())
  variantId          String
  pancakeWarehouseId String
  quantity           Float
  syncedAt           DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  variant            VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, pancakeWarehouseId])
  @@index([pancakeWarehouseId])
}

model CatalogSyncState {
  pancakeShopId Int      @id
  syncedAt      DateTime
  updatedAt     DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String        @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model OrderMirror {
  id                     String              @id @default(uuid())
  publicCode             String              @unique
  userId                 String?
  sourceCartId           String?
  pancakeShopId          Int?
  pancakeOrderId         String?             @unique
  pancakeSystemId        String?
  pancakeStatus          Int?
  pancakeStatusUpdatedAt String?
  state                  LocalOrderState     @default(DRAFT)
  syncErrorCode          String?
  checkoutSnapshottedAt  DateTime?
  guestName              String?
  guestPhone             String?
  provinceRef            String?
  districtRef            String?
  communeRef             String?
  addressDetail          String?
  note                   String?
  merchandiseSubtotalVnd BigInt?
  shippingFeeVnd         BigInt?
  totalVnd               BigInt?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines                  OrderLineSnapshot[]
  capacityReservations   CapacityReservation[]

  @@index([userId, createdAt])
  @@index([sourceCartId])
  @@index([state, createdAt])
}

/// The immutable finalized line. Every promotion column is additive and nullable so historical rows
/// stay valid and an application rollback is not blocked by a column older code never writes.
///
/// `unitPriceVnd` remains the final customer price; `baseUnitPriceVnd` records what it would have
/// been without a promotion. The promotion facts are a snapshot, not a foreign key: finalized order
/// history must never be rewritten by anything that later happens to a campaign row.
model OrderLineSnapshot {
  id                       String                 @id @default(cuid())
  orderId                  String
  variantId                String
  pancakeVariationId       String
  productName              String
  color                    String?
  size                     String
  quantity                 Int
  unitPriceVnd             BigInt
  lineTotalVnd             BigInt
  baseUnitPriceVnd         BigInt?
  promotionCampaignId      String?
  promotionName            String?
  promotionKind            PromotionCampaignKind?
  promotionDiscountType    PromotionDiscountType?
  promotionPercentageValue Int?
  promotionFixedPriceVnd   BigInt?
  createdAt                DateTime               @default(now())
  order                    OrderMirror            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// How a reserved unit of stock is identified. A standalone line consumes its own variant; a line for a
/// composite parent consumes each component variant, never the parent's own mirrored stock.
enum CapacityResourceKind {
  SELF
  COMPONENT
}

/// The local capacity hold for one purchased variant of one order.
///
/// Created in the same transaction that claims `POS_SUBMITTING`, i.e. before the Pancake create-order
/// request can be sent, and never earlier, so an order abandoned in `DRAFT`/`VALIDATING` holds nothing.
/// `acceptedAt` is written in the same transaction as `CONFIRMED`: it is the instant the exact Pancake
/// order was known to exist, and the causal lower bound a stock observation must start after before
/// any of this line's resources may hand their accounting to the mirror.
///
/// Both relations are `Restrict`: this is a capacity ledger and an audit record, so deleting the order
/// or the variant must fail loudly instead of silently freeing a hold that still counts.
model CapacityReservation {
  id         String                        @id @default(cuid())
  orderId    String
  variantId  String
  quantity   Int
  acceptedAt DateTime?
  createdAt  DateTime                      @default(now())
  order      OrderMirror                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant    VariantMirror                 @relation(fields: [variantId], references: [id], onDelete: Restrict)
  resources  CapacityReservationResource[]

  @@unique([orderId, variantId])
  @@index([variantId])
}

/// The concrete stock one reserved line consumes. Immutable once written: a later composite-topology
/// sync does not move an existing hold to different resources.
///
/// A resource counts in `activeReservedUnits` while `mirroredAt` is null. It stops counting only when a
/// Pancake stock observation that started after the line's `acceptedAt` has been stored for this
/// variant, and the reviewed Pancake contract guarantees that observation includes the order's stock
/// effect for this resource. The row stays for history after that; the handoff is a column, not a
/// delete.
model CapacityReservationResource {
  id                         String               @id @default(cuid())
  reservationId              String
  variantId                  String
  kind                       CapacityResourceKind
  /// Units of this resource one purchased unit consumes: 1 for SELF, the edge quantity for COMPONENT.
  unitsPerLine               Int
  quantity                   Int
  mirroredAt                 DateTime?
  mirrorObservationStartedAt DateTime?
  reservation                CapacityReservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  variant                    VariantMirror        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([reservationId, variantId])
  @@index([variantId, mirroredAt])
}

model SyncEvent {
  id         String          @id @default(cuid())
  kind       String
  externalId String?
  status     SyncEventStatus @default(PENDING)
  errorCode  String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind, status])
  @@index([externalId])
}

/// One slot of the curated New Arrivals selection (spec: docs/specs/core-kit-new-arrivals-curation-v1.md).
///
/// Website-owned: catalog sync never writes it. `position` is the administrator's stable manual order
/// and is the only ordering authority; the migration adds `CHECK (position >= 0 AND position < 500)`
/// and makes `position` a DEFERRABLE INITIALLY DEFERRED unique constraint, so the 500-slot ceiling is
/// a database fact and an atomic reorder can pass through a state where two rows briefly share a
/// position. Prisma models the unique constraint but cannot express either attribute. A deleted
/// product takes its slot with it (cascade); a hidden product keeps its slot and is suppressed at
/// render time only.
model NewArrivalsSelection {
  id              String        @id @default(cuid())
  productId       String        @unique
  position        Int           @unique
  addedAt         DateTime      @default(now())
  updatedByUserId String?
  product         ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy       User?         @relation("NewArrivalsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// Single-row optimistic-concurrency token for the New Arrivals selection, like
/// `PromotionPricingRevision`: bounded by construction, advanced in the same transaction as any write.
model NewArrivalsSelectionState {
  id        String   @id @default("current")
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

/// One slot of the homepage featured selection (A/B/C plan B04). Website-owned and deliberately
/// independent of `CollectionDefinition.featuredProductSlugs`: nothing is copied from a collection.
/// Same construction as `NewArrivalsSelection` -- a unique product, a unique deferrable position, and a
/// CHECK that makes the owner-approved ceiling of 12 a database fact.
model HomepageFeaturedProduct {
  id              String        @id @default(cuid())
  productId       String        @unique
  position        Int           @unique
  addedAt         DateTime      @default(now())
  updatedByUserId String?
  product         ProductMirror @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy       User?         @relation("HomepageFeaturedUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// Single-row optimistic-concurrency token for the homepage featured selection.
model HomepageFeaturedState {
  id        String   @id @default("current")
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

/// One manually chosen "related product" for a product (A/B/C plan B05). Website-owned; catalog sync
/// never writes it. Absence of rows means "use the documented fallback" (collection-projected
/// related products), never "no related products".
///
/// The migration adds `CHECK (productId <> relatedProductId)` and `CHECK (position >= 0 AND position < 8)`,
/// and makes `(productId, position)` a DEFERRABLE INITIALLY DEFERRED unique so a reorder can pass
/// through duplicate positions. Both foreign keys cascade: deleting either product removes the pair.
model RelatedProductOverride {
  id               String        @id @default(cuid())
  productId        String
  relatedProductId String
  position         Int
  addedAt          DateTime      @default(now())
  updatedByUserId  String?
  product          ProductMirror @relation("RelatedOverrideOwner", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   ProductMirror @relation("RelatedOverrideTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  updatedBy        User?         @relation("RelatedOverrideUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([productId, relatedProductId])
  @@unique([productId, position])
  @@index([relatedProductId])
  @@index([updatedByUserId])
}

/// Optional trusted image for one configured size-guide chart (A/B/C plan B06). Website-owned.
/// `guideKey` is a chart id from the brand `sizeGuide` config; the config is code, not a table, so
/// unknown keys are refused in the application rather than by a foreign key. The URL is validated by
/// `parseTrustedProductImageUrl` (HTTPS, the single reviewed host, reviewed path shape) before it is
/// stored, and the migration bounds every column again at the database.
model SizeGuideMedia {
  guideKey        String   @id
  imageUrl        String
  altText         String
  width           Int
  height          Int
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("SizeGuideMediaUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}
