# Server-only secrets. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/la_clothing"

# Server-owned storefront origin host. Public deployments use HTTPS automatically;
# localhost/127.0.0.1 may use an explicit port for local HTTP development.
APP_DOMAIN="localhost:3000"

# Search exposure is fail-closed. Keep false on local/staging and until the
# dedicated LA Clothing production domain passes the explicit launch gate.
SEARCH_INDEXING_ENABLED="false"

# Better Auth: generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Required for non-local deployments. Set this only to a single-value client-IP
# header that your edge/proxy overwrites and end users cannot spoof directly.
# Example for a suitably configured proxy/CDN: cf-connecting-ip, x-vercel-forwarded-for, etc.
# BETTER_AUTH_IP_HEADER="replace-with-your-trusted-client-ip-header"

PANCAKE_API_KEY="replace-me"
PANCAKE_SHOP_ID="replace-me"

# Server-owned shipping policy. Omit these to use the approved defaults:
# 30,000 VND shipping; free over 1,000,000 VND merchandise subtotal or from 3 items.
# Values must be canonical non-negative base-10 integers; minimum quantity must be >= 1.
# LA_SHIPPING_FEE_VND="30000"
# LA_FREE_SHIPPING_SUBTOTAL_VND="1000000"
# LA_FREE_SHIPPING_MIN_QUANTITY="3"

# Desired tracking mode: disabled | preview | live. Server-owned on purpose — a NEXT_PUBLIC_ value
# or any request input must never be able to promote a deployment to live. Omit for the fail-closed
# default of "disabled", which renders no dataLayer bootstrap and no page-view events at all.
#
# Google Tag Manager is NOT loaded in any mode yet: preview and live currently establish the
# first-party dataLayer, tracking mode and consent defaults only. The first actual GTM loader and
# the CSP origins it needs arrive with the unit that reviews an exact saved container version.
# LA_TRACKING_MODE="disabled"
# Required when LA_TRACKING_MODE is preview or live, rejected when it is disabled. Configuration
# identifier, not a secret.
# LA_GTM_CONTAINER_ID="GTM-XXXXXXX"

# Meta (Facebook) pixel — leave unset to ship no tracking at all.
# The 15-16 digit pixel id from Events Manager. Without it no script loads and the Content-Security
# Policy stays closed around Facebook's origins.
# This one is read at BUILD time: the CSP is assembled from it and baked into the build, so setting
# it only at runtime would render a script the policy then blocks. Rebuild after changing it.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
# Conversions API. Server-side Purchase reporting, deduplicated against the browser pixel by order
# code. Needs the pixel id above as well. This token is a secret — never expose it to the client.
FACEBOOK_CAPI_ACCESS_TOKEN=""
# Optional. Pins the Graph API version; confirm against Events Manager before changing.
FACEBOOK_GRAPH_API_VERSION="v21.0"
# Optional. Routes server events to Events Manager's Test Events tab instead of live reporting.
FACEBOOK_CAPI_TEST_EVENT_CODE=""

# Selling Modes v1 (docs/specs/core-kit-selling-modes-v1.md). Both off by default: every product sells
# STANDARD. SELLING_MODES_ENABLED is turned on only after slice M3 ships; SELLING_MODE_PREORDER_ENABLED
# only after Preorder truth v1. Only the exact value true enables either.
SELLING_MODES_ENABLED="false"
SELLING_MODE_PREORDER_ENABLED="false"

# Search suggestions (A/B/C plan B07, docs/verification/core-kit-a-b-c-slice-record.md). Off by default: the
# suggestion server action answers DISABLED without reading the catalog. Only the exact value true enables it.
SEARCH_SUGGESTIONS_ENABLED="false"

# Collapsible shop filters (A/B/C plan C02). Off by default: /shop renders the always-open filter form it
# always has. On, narrow viewports (below 1024px) collapse the form behind a "Bộ lọc" button. Only the
# exact value true enables it.
SHOP_FILTER_DISCLOSURE_ENABLED="false"

# Curated new arrivals (A/B/C plan B03). Off by default: /new-arrivals is the editorial drop page it has
# always been and reads nothing. On, it also lists the products an administrator curated at /admin/new-arrivals,
# 24 stored slots per page (?page=N). Only the exact value true enables it.
NEW_ARRIVALS_CURATION_ENABLED="false"

# Curated homepage selection (A/B/C plan B04). Off by default: the homepage "Tuyển chọn" shelf is the automatic
# first-20 discovery it has always been and reads nothing. On, it lists the products an administrator curated at
# /admin/homepage-featured (at most 12, in that order); an empty selection, or one whose products are all hidden,
# falls back to the automatic shelf. Only the exact value true enables it.
HOMEPAGE_FEATURED_ENABLED="false"

# Manual related products (A/B/C plan B05). Off by default: the product page's "Hoàn thiện phối đồ" rail is the
# collection-projected one it has always been and the override is never read. On, products an administrator
# chose at /admin/products/<id>/related (up to 8, the first 4 currently visible are shown) come first; with none
# to show, the collection-projected rail is used as before. Only the exact value true enables it.
RELATED_PRODUCTS_OVERRIDE_ENABLED="false"

# Mobile product page interactions (A/B/C plan C01). Off by default: the product page renders exactly as
# before. On, the gallery gains previous/next buttons, arrow/Home/End keys and touch swipe, and viewports below
# 1024px get a sticky purchase bar while the real panel is out of view. Only the exact value true enables it.
PDP_MOBILE_INTERACTIONS_ENABLED="false"

# Cart drawer (A/B/C plan C03). Off by default: the header cart link is a plain link to /cart. On, a plain click
# opens a read-only summary dialog of the cart; modified clicks and clients without scripting still reach /cart.
# Only the exact value true enables it.
CART_DRAWER_ENABLED="false"

# Search overlay (A/B/C plan C05). Off by default, and it only takes effect while SEARCH_SUGGESTIONS_ENABLED is
# also true: an overlay with nothing to suggest would open onto an error. On, a plain click on the header search
# link opens a dialog with a search field and the bounded suggestions; the field is a real GET form to /shop.
# Only the exact value true enables it.
SEARCH_OVERLAY_ENABLED="false"
